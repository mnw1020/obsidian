filters:
  and:
    - file.inFolder("Кино")
    - or:
        - file.hasTag("movies")
        - file.hasTag("serial")
formulas:
  type: if(file.hasTag("serial"), "📺 Сериал", if(file.hasTag("movies"), "🎬 Фильм", ""))
  rating: if(note.Оценка, number(note.Оценка), null)
  imdb_rating: if(note["Оценка Imdb"], number(note["Оценка Imdb"]), null)
  kp_rating: if(note["Оценка Кинопоиск"], number(note["Оценка Кинопоиск"]), null)
  rating_delta: if(formula.rating != null && formula.imdb_rating != null, (formula.rating - formula.imdb_rating).round(1), null)
  rating_delta_kp: if(formula.rating != null && formula.kp_rating != null, (formula.rating - formula.kp_rating).round(1), null)
  imdb_kp_delta: if(formula.imdb_rating != null && formula.kp_rating != null, (formula.imdb_rating - formula.kp_rating).round(1), null)
  watched: if(note.Просмотрено, note.Просмотрено.format("DD.MM.YYYY"), "")
  watch_count: if(note["Количество просмотров"], number(note["Количество просмотров"]), 1)
  release_raw: if(note.Релиз, note.Релиз.toString().trim().replace(/\\s+/g, " "), null)
  release_iso: if(!note.Релиз, null, if(note.Релиз.isType("date"), note.Релиз.format("YYYY-MM-DD"), if(/^\d{4}-\d{2}-\d{2}$/.matches(formula.release_raw), formula.release_raw, if(/^\d{1,2} (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) \d{4}$/i.matches(formula.release_raw), formula.release_raw.replace(/^(\d) ([A-Za-z]{3}) (\d{4})$/, "0$1 $2 $3").replace(/^(\d{2}) Jan (\d{4})$/i, "$2-01-$1").replace(/^(\d{2}) Feb (\d{4})$/i, "$2-02-$1").replace(/^(\d{2}) Mar (\d{4})$/i, "$2-03-$1").replace(/^(\d{2}) Apr (\d{4})$/i, "$2-04-$1").replace(/^(\d{2}) May (\d{4})$/i, "$2-05-$1").replace(/^(\d{2}) Jun (\d{4})$/i, "$2-06-$1").replace(/^(\d{2}) Jul (\d{4})$/i, "$2-07-$1").replace(/^(\d{2}) Aug (\d{4})$/i, "$2-08-$1").replace(/^(\d{2}) Sep (\d{4})$/i, "$2-09-$1").replace(/^(\d{2}) Oct (\d{4})$/i, "$2-10-$1").replace(/^(\d{2}) Nov (\d{4})$/i, "$2-11-$1").replace(/^(\d{2}) Dec (\d{4})$/i, "$2-12-$1"), null))))
  release_date: if(formula.release_iso, date(formula.release_iso), null)
  release_display: if(formula.release_date, formula.release_date.format("DD.MM.YYYY"), if(note.Релиз, note.Релиз.toString(), ""))
  release_year: if(formula.release_date, formula.release_date.year, null)
  entity_director: list(note["Режисер"]).filter(value != null && value != "").map(link("obsidian://quickadd?vault=obsidian&choice=%D0%9A%D0%B8%D0%BD%D0%BE%20-%20%D0%9E%D1%82%D0%BA%D1%80%D1%8B%D1%82%D1%8C%20%D1%80%D0%B5%D0%B6%D0%B8%D1%81%D1%81%D0%B5%D1%80%D0%B0&value-entity=" + value.toString().replace("%", "%25").replace("&", "%26").replace("+", "%2B").replace("#", "%23").replace("?", "%3F").replace("=", "%3D").replace(" ", "%20").replace("\"", "%22").replace("'", "%27").replace("<", "%3C").replace(">", "%3E").replace("\n", "%0A").replace("\r", "%0D").replace("\t", "%09"), value))
  entity_actor: list(note["Актеры"]).filter(value != null && value != "").map(link("obsidian://quickadd?vault=obsidian&choice=%D0%9A%D0%B8%D0%BD%D0%BE%20-%20%D0%9E%D1%82%D0%BA%D1%80%D1%8B%D1%82%D1%8C%20%D0%B0%D0%BA%D1%82%D0%B5%D1%80%D0%B0&value-entity=" + value.toString().replace("%", "%25").replace("&", "%26").replace("+", "%2B").replace("#", "%23").replace("?", "%3F").replace("=", "%3D").replace(" ", "%20").replace("\"", "%22").replace("'", "%27").replace("<", "%3C").replace(">", "%3E").replace("\n", "%0A").replace("\r", "%0D").replace("\t", "%09"), value))
  entity_genre: list(note["Жанр"]).filter(value != null && value != "").map(link("obsidian://quickadd?vault=obsidian&choice=%D0%9A%D0%B8%D0%BD%D0%BE%20-%20%D0%9E%D1%82%D0%BA%D1%80%D1%8B%D1%82%D1%8C%20%D0%B6%D0%B0%D0%BD%D1%80&value-entity=" + value.toString().replace("%", "%25").replace("&", "%26").replace("+", "%2B").replace("#", "%23").replace("?", "%3F").replace("=", "%3D").replace(" ", "%20").replace("\"", "%22").replace("'", "%27").replace("<", "%3C").replace(">", "%3E").replace("\n", "%0A").replace("\r", "%0D").replace("\t", "%09"), value))
properties:
  file.name:
    displayName: Название
  note.Название:
    displayName: Оригинальное название
  note.Описание:
    displayName: Описание
  formula.type:
    displayName: Тип
  formula.watched:
    displayName: Просмотрено
  formula.watch_count:
    displayName: Просмотров
  formula.rating:
    displayName: Моя оценка
  formula.imdb_rating:
    displayName: IMDb
  formula.kp_rating:
    displayName: КП
  formula.rating_delta:
    displayName: Δ к IMDb
  formula.rating_delta_kp:
    displayName: Δ к КП
  formula.imdb_kp_delta:
    displayName: IMDb − КП
  formula.release_display:
    displayName: Релиз
  formula.release_year:
    displayName: Год
  note.Жанр:
    displayName: Жанр
  note.Режисер:
    displayName: Режиссёр
  formula.entity_director:
    displayName: Режиссер
  formula.entity_actor:
    displayName: Актер
  formula.entity_genre:
    displayName: Жанр
views:
  - type: dynamic-views-grid
    name: Последние
    order:
      - file.name
      - formula.rating
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 20
    cardSize: 200
    imageFit: contain
    textPreviewProperty: note.Описание
    fallbackToContent: false
    textPreviewLines: 7
    imageProperty: note.poster
    imageFormat: poster
    propertyNames: hide
    id: 0myciy-Последние
    displayFirstAsTitle: true
    showFileImages: never
    minimumColumns: one
    displaySecondAsSubtitle: false
  - type: dynamic-views-grid
    name: Последние сериалы
    filters:
      and:
        - file.hasTag("serial")
    order:
      - file.name
      - formula.rating
      - Сезон
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 20
    cardSize: 200
    imageFit: contain
    textPreviewProperty: note.Описание
    fallbackToContent: false
    textPreviewLines: 7
    imageProperty: note.poster
    imageFormat: poster
    propertyNames: hide
    id: 4i9sz1-Последние сериалы
    displayFirstAsTitle: true
    showFileImages: never
    minimumColumns: one
    displaySecondAsSubtitle: false
  - type: table
    name: Все
    order:
      - file.name
      - Название
      - formula.type
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - formula.kp_rating
      - formula.release_display
      - formula.entity_genre
      - formula.entity_director
      - formula.entity_actor
    sort:
      - property: formula.entity_actor
        direction: DESC
      - property: formula.type
        direction: DESC
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
  - type: table
    name: Фильмы
    filters:
      and:
        - file.hasTag("movies")
    order:
      - file.name
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - formula.kp_rating
      - formula.release_display
      - formula.entity_genre
      - Описание
      - formula.entity_director
      - formula.entity_actor
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 100
    image: note.poster
    imageAspectRatio: 0.67
    imageFit: contain
    cardSize: 175
  - type: table
    name: Сериалы
    filters:
      and:
        - file.hasTag("serial")
    order:
      - file.name
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - formula.kp_rating
      - formula.release_display
      - formula.entity_genre
      - Описание
      - formula.entity_director
      - formula.entity_actor
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 100
    image: note.poster
    imageAspectRatio: 0.67
    imageFit: contain
    cardSize: 175
  - type: table
    name: По году релиза
    filters:
      and:
        - formula.release_date != null
    groupBy:
      property: formula.release_year
      direction: DESC
    order:
      - file.name
      - formula.type
      - formula.release_display
      - formula.rating
      - formula.imdb_rating
      - formula.kp_rating
      - formula.watched
      - formula.entity_genre
      - formula.entity_director
      - formula.entity_actor
    sort:
      - property: formula.release_date
        direction: DESC
      - property: formula.rating
        direction: DESC
  - type: table
    name: Сравнение оценок
    filters:
      and:
        - formula.rating != null || formula.imdb_rating != null || formula.kp_rating != null
    order:
      - file.name
      - formula.type
      - formula.rating
      - formula.imdb_rating
      - formula.kp_rating
      - formula.rating_delta
      - formula.rating_delta_kp
      - formula.imdb_kp_delta
    sort:
      - property: file.name
        direction: ASC
  - type: dynamic-views-grid
    name: Перепросмотры
    filters:
      and:
        - formula.watch_count > 1
    order:
      - file.name
      - formula.watch_count
      - formula.rating
      - formula.imdb_rating
      - formula.kp_rating
      - formula.watched
    sort:
      - property: formula.watch_count
        direction: DESC
      - property: Просмотрено
        direction: DESC
    limit: 20
    cardSize: 200
    imageFit: contain
    textPreviewProperty: note.Описание
    fallbackToContent: false
    textPreviewLines: 7
    imageProperty: note.poster
    imageFormat: poster
    propertyNames: inline
    id: 19bbu7-Перепросмотры
    displayFirstAsTitle: true
    showFileImages: never
    minimumColumns: one
    displaySecondAsSubtitle: false
  - type: table
    name: Проблемные даты
    filters:
      and:
        - note.Релиз != null
        - formula.release_date == null
    order:
      - file.name
      - Релиз
      - formula.type
      - formula.watched
      - formula.entity_director
      - formula.entity_actor
      - formula.entity_genre
    sort:
      - property: file.name
        direction: ASC
