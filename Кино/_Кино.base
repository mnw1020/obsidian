filters:
  and:
    - file.inFolder("Кино")
    - or:
        - file.hasTag("movies")
        - file.hasTag("serial")
formulas:
  type: if(file.hasTag("serial"), "📺 Сериал", if(file.hasTag("movies"), "🎬 Фильм", ""))
  rating: if(note.Оценка, number(note.Оценка), null)
  imdb_rating: if(note["Оценка Imdb"], number(note["Оценка Imdb"]), null)
  rating_delta: if(formula.rating != null && formula.imdb_rating != null, (formula.rating - formula.imdb_rating).round(1), null)
  watched: if(note.Просмотрено, note.Просмотрено.format("DD.MM.YYYY"), "")
  watch_count: if(note["Количество просмотров"], number(note["Количество просмотров"]), 1)
  release_raw: if(note.Релиз, note.Релиз.toString().trim().replace(/\\s+/g, " "), null)
  release_iso: if(!note.Релиз, null, if(note.Релиз.isType("date"), note.Релиз.format("YYYY-MM-DD"), if(/^\d{4}-\d{2}-\d{2}$/.matches(formula.release_raw), formula.release_raw, if(/^\d{1,2} (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) \d{4}$/i.matches(formula.release_raw), formula.release_raw.replace(/^(\d) ([A-Za-z]{3}) (\d{4})$/, "0$1 $2 $3").replace(/^(\d{2}) Jan (\d{4})$/i, "$2-01-$1").replace(/^(\d{2}) Feb (\d{4})$/i, "$2-02-$1").replace(/^(\d{2}) Mar (\d{4})$/i, "$2-03-$1").replace(/^(\d{2}) Apr (\d{4})$/i, "$2-04-$1").replace(/^(\d{2}) May (\d{4})$/i, "$2-05-$1").replace(/^(\d{2}) Jun (\d{4})$/i, "$2-06-$1").replace(/^(\d{2}) Jul (\d{4})$/i, "$2-07-$1").replace(/^(\d{2}) Aug (\d{4})$/i, "$2-08-$1").replace(/^(\d{2}) Sep (\d{4})$/i, "$2-09-$1").replace(/^(\d{2}) Oct (\d{4})$/i, "$2-10-$1").replace(/^(\d{2}) Nov (\d{4})$/i, "$2-11-$1").replace(/^(\d{2}) Dec (\d{4})$/i, "$2-12-$1"), null))))
  release_date: if(formula.release_iso, date(formula.release_iso), null)
  release_display: if(formula.release_date, formula.release_date.format("DD.MM.YYYY"), if(note.Релиз, note.Релиз.toString(), ""))
  release_year: if(formula.release_date, formula.release_date.year, null)
properties:
  file.name:
    displayName: Название
  note.Название:
    displayName: Оригинальное название
  note.Описание:
    displayName: Описание
  formula.type:
    displayName: Тип
  formula.watched:
    displayName: Просмотрено
  formula.watch_count:
    displayName: Просмотров
  formula.rating:
    displayName: Моя оценка
  formula.imdb_rating:
    displayName: IMDb
  formula.rating_delta:
    displayName: Δ к IMDb
  formula.release_display:
    displayName: Релиз
  formula.release_year:
    displayName: Год
  note.Жанр:
    displayName: Жанр
  note.Режисер:
    displayName: Режиссёр
views:
  - type: dynamic-views-grid
    name: Последние
    order:
      - file.name
      - formula.rating
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 20
    cardSize: 200
    imageFit: contain
    textPreviewProperty: note.Описание
    fallbackToContent: false
    textPreviewLines: 7
    imageProperty: note.poster
    imageFormat: poster
    propertyNames: hide
    id: 0myciy-Последние
    displayFirstAsTitle: true
    showFileImages: never
    minimumColumns: one
    displaySecondAsSubtitle: false
  - type: dynamic-views-grid
    name: Последние сериалы
    filters:
      and:
        - file.hasTag("serial")
    order:
      - file.name
      - formula.rating
      - Сезон
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 20
    cardSize: 200
    imageFit: contain
    textPreviewProperty: note.Описание
    fallbackToContent: false
    textPreviewLines: 7
    imageProperty: note.poster
    imageFormat: poster
    propertyNames: hide
    id: 0myciy-Последние
    displayFirstAsTitle: true
    showFileImages: never
    minimumColumns: one
    displaySecondAsSubtitle: false
  - type: table
    name: Все
    order:
      - file.name
      - Название
      - formula.type
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - formula.release_display
      - Жанр
      - Режисер
    sort:
      - property: formula.type
        direction: DESC
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
  - type: table
    name: Фильмы
    filters:
      and:
        - file.hasTag("movies")
    order:
      - file.name
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - formula.release_display
      - Жанр
      - Описание
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 100
    image: note.poster
    imageAspectRatio: 0.67
    imageFit: contain
    cardSize: 175
  - type: cards
    name: Сериалы
    filters:
      and:
        - file.hasTag("serial")
    order:
      - file.name
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - formula.release_display
      - Жанр
      - Описание
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 100
    image: note.poster
    imageAspectRatio: 0.67
    imageFit: contain
    cardSize: 175
  - type: table
    name: По году релиза
    filters:
      and:
        - formula.release_date != null
    groupBy:
      property: formula.release_year
      direction: DESC
    order:
      - file.name
      - formula.type
      - formula.release_display
      - formula.rating
      - formula.imdb_rating
      - formula.watched
      - Жанр
    sort:
      - property: formula.release_date
        direction: DESC
      - property: formula.rating
        direction: DESC
  - type: table
    name: Выше IMDb
    filters:
      and:
        - formula.rating_delta != null
    order:
      - file.name
      - formula.type
      - formula.rating
      - formula.imdb_rating
      - formula.rating_delta
      - formula.watched
    sort:
      - property: formula.rating_delta
        direction: ASC
      - property: formula.rating
        direction: DESC
  - type: cards
    name: Перепросмотры
    filters:
      and:
        - formula.watch_count > 1
    order:
      - file.name
      - formula.watch_count
      - formula.rating
      - formula.watched
    sort:
      - property: formula.watch_count
        direction: DESC
      - property: Просмотрено
        direction: DESC
    limit: 12
    image: note.poster
    imageAspectRatio: 0.67
    imageFit: contain
    cardSize: 175
  - type: table
    name: Проблемные даты
    filters:
      and:
        - note.Релиз != null
        - formula.release_date == null
    order:
      - file.name
      - Релиз
      - formula.type
      - formula.watched
    sort:
      - property: file.name
        direction: ASC
