formulas:
  type: if(file.hasTag("serial"), "📺 Сериал", if(file.hasTag("movies"), "🎬 Фильм", ""))
  watched: if(note.Просмотрено, note.Просмотрено.format("DD.MM.YYYY"), "")
  rating: if(note.Оценка, number(note.Оценка), null)
  imdb_rating: if(note["Оценка Imdb"], number(note["Оценка Imdb"]), null)
properties:
  formula.type:
    displayName: Тип
  formula.watched:
    displayName: Просмотрено
  formula.rating:
    displayName: Моя оценка
  formula.imdb_rating:
    displayName: IMDb
  note.Жанр:
    displayName: Жанр
  note.Режисер:
    displayName: Режиссёр
views:
  - type: cards
    name: Последние
    order:
      - file.name
      - formula.type
      - formula.watched
      - formula.rating
      - formula.imdb_rating
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 100
    image: note.poster
    imageFit: contain
    imageAspectRatio: 0.67
    cardSize: 180
  - type: cards
    name: Фильмы
    filters:
      and:
        - file.hasTag("movies")
    order:
      - file.name
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - Жанр
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 100
    image: note.poster
    imageFit: contain
    imageAspectRatio: 0.67
    cardSize: 180
  - type: cards
    name: Сериалы
    filters:
      and:
        - file.hasTag("serial")
    order:
      - file.name
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - Жанр
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
    limit: 100
    image: note.poster
    imageFit: contain
    imageAspectRatio: 0.67
    cardSize: 180
  - type: cards
    name: Лучшие
    order:
      - file.name
      - formula.type
      - formula.rating
      - formula.imdb_rating
      - formula.watched
    sort:
      - property: formula.rating
        direction: DESC
      - property: formula.imdb_rating
        direction: DESC
      - property: Просмотрено
        direction: DESC
    limit: 100
    image: note.poster
    imageFit: contain
    imageAspectRatio: 0.67
    cardSize: 180
  - type: table
    name: Все
    order:
      - file.name
      - formula.type
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - Жанр
      - Режисер
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
  - type: table
    name: По типу
    filters:
      and:
        - file.tags == ["movies"]
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - file.name
      - formula.watched
      - formula.rating
      - formula.imdb_rating
      - Жанр
    sort:
      - property: Просмотрено
        direction: DESC
      - property: formula.rating
        direction: DESC
  - type: table
    name: Недавно изменённые
    order:
      - file.name
      - formula.type
      - file.mtime
      - formula.watched
      - formula.rating
    sort:
      - property: file.mtime
        direction: DESC
    limit: 100
