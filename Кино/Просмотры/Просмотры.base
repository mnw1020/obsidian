filters:
  and:
    - file.inFolder("Кино/Просмотры")
    - file.hasTag("viewing")
formulas:
  when: if(note.Дата, note.Дата.format("DD.MM.YYYY"), if(note.Год, note.Год.toString(), ""))
  rating: if(note.Оценка, number(note.Оценка), null)
  viewing_label: 'if(note.Просмотр, "Просмотр #" + number(note.Просмотр).toString(), "")'
properties:
  note.Фильм:
    displayName: Фильм
  note.Просмотр:
    displayName: №
  formula.viewing_label:
    displayName: Просмотр
  formula.when:
    displayName: Когда
  formula.rating:
    displayName: Оценка
  note.Комментарий:
    displayName: Комментарий
views:
  - type: table
    name: Все просмотры
    order:
      - Фильм
      - formula.viewing_label
      - formula.when
      - formula.rating
      - Комментарий
    sort:
      - property: Год
        direction: DESC
      - property: Дата
        direction: DESC
      - property: Просмотр
        direction: DESC
  - type: table
    name: Повторные просмотры
    filters:
      and:
        - Просмотр > 1
    order:
      - Фильм
      - formula.viewing_label
      - formula.when
      - formula.rating
      - Комментарий
    sort:
      - property: Год
        direction: DESC
      - property: Дата
        direction: DESC
      - property: Просмотр
        direction: DESC
