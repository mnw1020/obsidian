filters:
  and:
    - note.authors
    - or:
        - file.inFolder("Книги/Художественные")
        - file.inFolder("Книги/Non-fiction")
formulas:
  book_link: file.asLink(note.title)
  series_group: if(note.series, note.series, "Без серии")
  work_type: if(note.work_type, if(note.work_type == "story", "📄 Рассказ", if(note.work_type == "lecture", "🎓 Лекция", if(note.work_type == "article", "📰 Статья", "❓ Другое"))), "📕 Книга")
  author_links: note.authors.map(link("obsidian://quickadd?choice=%D0%9A%D0%BD%D0%B8%D0%B3%D0%B8%20-%20%D0%9E%D1%82%D0%BA%D1%80%D1%8B%D1%82%D1%8C%20%D0%B0%D0%B2%D1%82%D0%BE%D1%80%D0%B0&value-author=" + value.replace("%", "%25").replace(" ", "%20").replace("&", "%26").replace("#", "%23").replace("?", "%3F").replace("=", "%3D").replace("+", "%2B").replace("/", "%2F"), value))
  series_link: if(note.series, link("obsidian://quickadd?choice=%D0%9A%D0%BD%D0%B8%D0%B3%D0%B8%20-%20%D0%9E%D1%82%D0%BA%D1%80%D1%8B%D1%82%D1%8C%20%D1%81%D0%B5%D1%80%D0%B8%D1%8E&value-series=" + note.series.replace("%", "%25").replace(" ", "%20").replace("&", "%26").replace("#", "%23").replace("?", "%3F").replace("=", "%3D").replace("+", "%2B").replace("/", "%2F"), note.series), "")
properties:
  formula.book_link:
    displayName: Произведение
  formula.author_links:
    displayName: Автор
  formula.work_type:
    displayName: Тип
  note.rating:
    displayName: Оценка
  note.date:
    displayName: Последнее чтение
  note.read_count:
    displayName: Чтений
  formula.series_link:
    displayName: Серия
  note.series_index:
    displayName: №
views:
  - type: table
    name: Все
    groupBy:
      property: date
      direction: DESC
    order:
      - formula.book_link
      - formula.author_links
      - formula.work_type
      - rating
      - date
      - read_count
      - formula.series_link
      - series_index
    sort:
      - property: formula.book_link
        direction: ASC
  - type: table
    name: По типу
    groupBy:
      property: formula.work_type
      direction: ASC
    order:
      - formula.book_link
      - formula.author_links
      - formula.work_type
      - rating
      - date
      - read_count
      - formula.series_link
      - series_index
    sort:
      - property: formula.author_links
        direction: ASC
      - property: formula.book_link
        direction: ASC
  - type: table
    name: Художественные
    filters:
      and:
        - file.inFolder("Книги/Художественные")
    order:
      - formula.book_link
      - formula.author_links
      - formula.work_type
      - rating
      - date
      - read_count
      - formula.series_link
      - series_index
    sort:
      - property: formula.author_links
        direction: DESC
      - property: date
        direction: DESC
  - type: table
    name: Non-fiction
    filters:
      and:
        - file.inFolder("Книги/Non-fiction")
    order:
      - formula.book_link
      - formula.author_links
      - formula.work_type
      - date
      - read_count
      - formula.series_link
      - series_index
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Перечитанные
    filters:
      and:
        - note.read_count > 1
    order:
      - formula.book_link
      - formula.author_links
      - formula.work_type
      - rating
      - date
      - read_count
      - formula.series_link
      - series_index
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Автор
    filters:
      and:
        - note.authors.contains(this.selected_author)
    groupBy:
      property: formula.series_group
      direction: ASC
    order:
      - formula.book_link
      - formula.work_type
      - formula.series_link
      - series_index
      - rating
      - date
      - read_count
    sort:
      - property: series_index
        direction: ASC
      - property: date
        direction: DESC
  - type: table
    name: Серия
    filters:
      and:
        - note.series == this.selected_series
    order:
      - series_index
      - formula.book_link
      - formula.work_type
      - formula.author_links
      - rating
      - date
      - read_count
    sort:
      - property: series_index
        direction: ASC
      - property: date
        direction: DESC
