filters:
  and:
    - authors
    - file.path.startsWith("Книги/")
formulas:
  book_link: file.asLink(title)
  series_group: if(series, series, "Без серии")
properties:
  formula.book_link:
    displayName: Книга
  authors:
    displayName: Автор
  rating:
    displayName: Оценка
  date:
    displayName: Последнее чтение
  read_count:
    displayName: Чтений
  series:
    displayName: Серия
  series_index:
    displayName: №
views:
  - type: table
    name: Все
    order:
      - formula.book_link
      - authors
      - rating
      - date
      - read_count
      - series
      - series_index
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Последние
    order:
      - formula.book_link
      - authors
      - rating
      - date
      - read_count
    sort:
      - property: date
        direction: DESC
    limit: 40
  - type: table
    name: Лучшие
    filters:
      and:
        - rating >= 8
    order:
      - formula.book_link
      - authors
      - rating
      - date
      - read_count
    sort:
      - property: rating
        direction: DESC
      - property: date
        direction: DESC
  - type: table
    name: Художественные
    filters:
      and:
        - file.inFolder("Книги/Художественные")
    order:
      - formula.book_link
      - authors
      - rating
      - date
      - read_count
      - series
      - series_index
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Non-fiction
    filters:
      and:
        - file.inFolder("Книги/Non-fiction")
    order:
      - formula.book_link
      - authors
      - date
      - read_count
      - series
      - series_index
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Без оценки
    filters:
      and:
        - file.inFolder("Книги/Художественные")
        - "!rating"
    order:
      - formula.book_link
      - authors
      - date
      - read_count
      - series
      - series_index
    sort:
      - property: date
        direction: DESC
  - type: table
    name: Автор
    filters:
      and:
        - authors.contains(this)
    groupBy:
      property: formula.series_group
      direction: ASC
    order:
      - formula.book_link
      - series_index
      - rating
      - date
      - read_count
    sort:
      - property: series_index
        direction: ASC
      - property: date
        direction: DESC
