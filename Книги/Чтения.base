filters:
  and:
    - 'kind == "reading"'
    - 'file.inFolder("Книги/Чтения")'
formulas:
  entry_link: 'file.asLink("Открыть")'
properties:
  book:
    displayName: Книга
  read_date:
    displayName: Дата
  rating:
    displayName: Оценка
  formula.entry_link:
    displayName: Запись
views:
  - type: table
    name: Все чтения
    order:
      - read_date
      - book
      - rating
      - formula.entry_link
    sort:
      - property: read_date
        direction: DESC
  - type: table
    name: История книги
    filters:
      and:
        - 'book == this.file'
    order:
      - read_date
      - rating
      - formula.entry_link
    sort:
      - property: read_date
        direction: DESC
