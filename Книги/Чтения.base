filters:
  and:
    - 'file.inFolder("Книги/Чтения")'
    - 'file.hasTag("reading")'
formulas:
  reading_label: 'if(Чтение, "Чтение #" + number(Чтение).toString(), "")'
  entry_link: 'file.asLink("Открыть")'
properties:
  Книга:
    displayName: Книга
  Чтение:
    displayName: №
  formula.reading_label:
    displayName: Чтение
  Дата:
    displayName: Когда
  Оценка:
    displayName: Оценка
  Комментарий:
    displayName: Комментарий
  formula.entry_link:
    displayName: Версия
views:
  - type: table
    name: Все чтения
    order:
      - Книга
      - formula.reading_label
      - Дата
      - Оценка
      - Комментарий
      - formula.entry_link
    sort:
      - property: Дата
        direction: DESC
      - property: Чтение
        direction: DESC
  - type: table
    name: Повторные чтения
    filters:
      and:
        - 'Чтение > 1'
    order:
      - Книга
      - formula.reading_label
      - Дата
      - Оценка
      - Комментарий
      - formula.entry_link
    sort:
      - property: Дата
        direction: DESC
      - property: Чтение
        direction: DESC
  - type: table
    name: История книги
    filters:
      and:
        - 'Книга == this.file'
    order:
      - formula.reading_label
      - Дата
      - Оценка
      - Комментарий
      - formula.entry_link
    sort:
      - property: Чтение
        direction: DESC
